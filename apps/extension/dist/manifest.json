{
  "manifest_version": 2,
  "name": "Passwuts",
  "description": "Secure password manager",
  "version": "0.0.1",

  "browser_action": {
    "default_popup": "popup/index.html"
  },

  "background": {
    "scripts": ["background/index.js"]
  },

  "permissions": [
    "storage",
    "activeTab",
    "https://passwuts-web.vercel.app/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "passwuts@passwuts-web.vercel.app"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"]
    }
  ]
}
